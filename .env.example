# Vercel environment variables for All In

# Required for AI features
ANTHROPIC_API_KEY=sk-ant-...

# Signs subscription tokens — ties AI access to paid tier
SUBSCRIPTION_SIGNING_SECRET=your-random-signing-secret

# Coach personal AI (does not use client subscription pool)
AI_COACH_ACCESS_TOKEN=your-secret-coach-token

# Beta: allow tier activation without coach token (dev only)
# ALLOW_DEV_SUBSCRIPTION_MINT=true

# Kill switch
# AI_CHAT_DISABLED=true

# Coach personal daily cap
# AI_COACH_DAILY_LIMIT=100
