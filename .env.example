# Vercel environment variables for All In

# Required — powers AI coach + nutrition scanning (server-side only)
ANTHROPIC_API_KEY=sk-ant-...

# Solo mode (default): leave the next two unset.
# AI works with a daily cap (AI_DAILY_MESSAGE_LIMIT, default 30). No phone tokens needed.

# Multi-client lock — set when you have paying clients:
# AI_COACH_ACCESS_TOKEN=your-secret-coach-token
# SUBSCRIPTION_SIGNING_SECRET=your-random-signing-secret

# Optional
# AI_DAILY_MESSAGE_LIMIT=30
# AI_COACH_DAILY_LIMIT=100
# AI_CHAT_DISABLED=true
# ALLOW_DEV_SUBSCRIPTION_MINT=true
