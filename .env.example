# Vercel environment variables for All In

# Required for AI features
ANTHROPIC_API_KEY=sk-ant-...

# Coach-only AI — clients without this token in their request get 403 (no Anthropic charge)
AI_COACH_ACCESS_TOKEN=your-secret-coach-token

# Kill switch — set to true to disable all AI
# AI_CHAT_DISABLED=true

# Daily caps (per device, resets midnight UTC)
# AI_DAILY_MESSAGE_LIMIT=15
# AI_COACH_DAILY_LIMIT=100
